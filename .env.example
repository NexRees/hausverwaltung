DATABASE_URL="postgresql://havewa:havewa@localhost:5432/havewa?schema=public"
# openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Optional: öffentliche Adresse der App, für Links in E-Mail-Benachrichtigungen (#77)
# APP_URL="https://havewa.example.com"

# --- Optionales OIDC/SSO (Authentik, Keycloak, …) ---
# Wenn gesetzt, erscheint im Login ein "Mit <Name> anmelden"-Button. Es melden
# sich NUR bereits angelegte Benutzer an (Abgleich per E-Mail); Rolle und Mandant
# stammen aus dem vorhandenen Benutzer. Redirect-URI beim IdP:
#   https://<DOMAIN>/api/auth/callback/oidc
# OIDC_ISSUER="https://id.example.com/application/o/havewa/"
# OIDC_CLIENT_ID="..."
# OIDC_CLIENT_SECRET="..."
# OIDC_NAME="Authentik"
# nexrees: verified accounts on these domains get a user on first SSO sign-in (Google: issuer
# https://accounts.google.com, Workspace claim hd must match). Role never ADMIN.
# SSO_AUTO_PROVISION_DOMAINS="nexrees.de"
# SSO_DEFAULT_ROLE="VERWALTER"

# --- Optionaler Bootstrap beim ersten Start (alle optional) ---
# 1) Demo-Datensatz einspielen (Admin: admin@havewa.app / admin).
#    Wenn gesetzt, werden ADMIN_*/TENANT_NAME ignoriert.
# SEED_DEMO=true
#
# 2) Ohne Demo: Mandant + Admin direkt anlegen -> der Einrichtungs-Wizard entfällt.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="bitte-aendern"
# ADMIN_NAME="Admin"                    # optional, Standard: "Admin"
# TENANT_NAME="Meine Hausverwaltung"    # optional, Standard: "HaVeWa"
#
# 3) Nichts gesetzt -> Ersteinrichtung über den Wizard beim ersten Login.

# --- nexrees: Datenhaltung / KI (src/lib/ai-residency.ts) ---
# Mit DATA_RESIDENCY gehen Firmendaten nur an KI-Endpunkte in dieser Region (Terraform setzt es).
# DATA_RESIDENCY="eu-central-1"
# AI_PROVIDER="bedrock"                 # anthropic | openai | bedrock (Standard für Mandanten ohne Einstellung)
# AI_MODEL="<Bedrock-Modell-ID ohne eu./global.-Präfix, in der Region verfügbar>"
# AI_BEDROCK_REGION="eu-central-1"      # sonst AWS_REGION
# AI_ALLOWED_HOSTS="llm.example.de"     # OpenAI-kompatible Gateways, die in der Region verarbeiten
# AI_ALLOW_EU_CROSS_REGION=false        # true erlaubt eu.-Inferenzprofile (andere EU-Regionen!)
